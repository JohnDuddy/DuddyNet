# DuddyNet — example environment file.
# Copy to ".env" for LOCAL DEVELOPMENT ONLY. Never commit a real .env.
#
# In production the agent is configured via config.yaml (see agent/config.example.yaml).
# These env vars override config file values when set and are handy for dev/CI.

# Path to the agent config file. If unset the agent uses the OS default:
#   Linux:   /etc/duddynet/config.yaml
#   Windows: %ProgramData%\DuddyNet\config.yaml
DUDDYNET_CONFIG=./config.yaml

# Override the listen address/port (optional).
DUDDYNET_LISTEN_ADDRESS=
DUDDYNET_LISTEN_PORT=

# Override the data/database path (optional).
DUDDYNET_DATABASE_PATH=

# NOTE: There are intentionally NO Tailscale auth keys, OAuth secrets, or admin
# API tokens here. Those belong on the home machine's Tailscale client / admin
# console only — never in this repo and never in the Android app.

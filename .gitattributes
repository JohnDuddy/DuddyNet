# Normalize line endings: store text as LF in the repo (Go/Kotlin convention).
* text=auto eol=lf

# Windows-specific scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat known binaries as binary (none committed today, but future-proof).
*.png binary
*.jpg binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
